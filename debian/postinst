#!/bin/sh
set -e

case "$1" in
    configure)
        # Verzeichnis für Keyrings sicherstellen
        echo "Erstelle /usr/share/keyrings falls nicht vorhanden..."
        install -d -m 755 /usr/share/keyrings

        # Alte Dateien entfernen
        FILES="
/etc/apt/sources.list.d/home:guideos:cinnamon-trixie.list.bak
/etc/apt/sources.list.d/home:guideos:cinnamon-trixie.sources
/etc/apt/sources.list.d/home:guideos:trixie.list.bak
/etc/apt/sources.list.d/home:guideos:trixie.sources
/etc/apt/sources.list.d/home:guideos:universe.list.bak
/etc/apt/sources.list.d/home:guideos:universe.sources
/etc/apt/trusted.gpg.d/home_guideos_cinnamon-trixie.gpg
/etc/apt/trusted.gpg.d/home_guideos_trixie.gpg
/etc/apt/trusted.gpg.d/home_guideos_universe.gpg
        "

        for f in $FILES; do
            if [ -e "$f" ]; then
                echo "Entferne $f ..."
                rm -f "$f"
            fi
        done

        # Neue Sources-Dateien anlegen
        echo "Erstelle neue .sources Dateien..."

        cat > /etc/apt/sources.list.d/home:guideos:cinnamon-trixie.sources << 'EOF'
Types: deb
URIs: https://download.opensuse.org/repositories/home:guideos:cinnamon-trixie/Debian_13/
Suites: /
Components: 
Signed-By: /usr/share/keyrings/home_guideos_cinnamon-trixie.gpg
EOF

        cat > /etc/apt/sources.list.d/home:guideos:universe.sources << 'EOF'
Types: deb
URIs: https://download.opensuse.org/repositories/home:guideos:universe/Debian_13/
Suites: /
Components: 
Signed-By: /usr/share/keyrings/home_guideos_universe.gpg
EOF

        cat > /etc/apt/sources.list.d/home:guideos:trixie.sources << 'EOF'
Types: deb
URIs: https://download.opensuse.org/repositories/home:guideos:trixie/Debian_13/
Suites: /
Components: 
Signed-By: /usr/share/keyrings/home_guideos_trixie.gpg
EOF

        # Keyrings importieren
        echo "Importiere GPG-Keys..."
        curl -fsSL https://download.opensuse.org/repositories/home:guideos:cinnamon-trixie/Debian_13/Release.key \
            | gpg --dearmor > /usr/share/keyrings/home_guideos_cinnamon-trixie.gpg

        curl -fsSL https://download.opensuse.org/repositories/home:guideos:universe/Debian_13/Release.key \
            | gpg --dearmor > /usr/share/keyrings/home_guideos_universe.gpg

        curl -fsSL https://download.opensuse.org/repositories/home:guideos:trixie/Debian_13/Release.key \
            | gpg --dearmor > /usr/share/keyrings/home_guideos_trixie.gpg

        # apt Update ausführen
        echo "Aktualisiere Paketquellen..."
        apt-get update || true
        ;;
esac

exit 0
